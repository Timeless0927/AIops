{
  "openapi": "3.1.0",
  "info": {"title": "AIOps Gateway Console API", "version": "1.0.0"},
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}},
        "responses": {
          "200": {"description": "Cookie session created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "responses": {
          "200": {"description": "CSRF token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CsrfResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {"description": "Session ended", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OkResponse"}}}},
          "403": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/auth/reauth": {
      "post": {
        "operationId": "reauthenticate",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["password"], "properties": {"password": {"type": "string", "minLength": 1}}}}}},
        "responses": {
          "200": {"description": "Fresh authentication recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OkResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/actor": {
      "get": {
        "operationId": "getActor",
        "responses": {
          "200": {"description": "Current actor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActorResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/incidents": {
      "get": {
        "operationId": "listIncidents",
        "responses": {
          "200": {"description": "Visible incidents", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IncidentListResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/incidents/{id}/workbench": {
      "get": {
        "operationId": "getIncidentWorkbench",
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "responses": {
          "200": {"description": "Incident-scoped Workbench snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkbenchResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/incidents/{id}/reinvestigate": {
      "post": {
        "operationId": "reinvestigateIncident",
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReinvestigateRequest"}}}},
        "responses": {
          "200": {"description": "Next Investigation created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvestigationResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/investigations/{id}/events": {
      "get": {
        "operationId": "listInvestigationEvents",
        "parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "after", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}}],
        "responses": {
          "200": {"description": "Ordered Investigation Event page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvestigationEventsResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/investigations/{id}/events/stream": {
      "get": {
        "operationId": "streamInvestigationEvents",
        "parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "after", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "Last-Event-ID", "in": "header", "schema": {"type": "integer", "minimum": 0}}],
        "responses": {
          "200": {"description": "Resumable Investigation Event stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/investigations/{id}/human-input": {
      "post": {
        "operationId": "submitHumanInput",
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HumanInputRequest"}}}},
        "responses": {
          "200": {"description": "Human Input appended", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvestigationEventResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/investigations/{id}/controls": {
      "post": {
        "operationId": "controlInvestigation",
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvestigationControlRequest"}}}},
        "responses": {
          "200": {"description": "Investigation lifecycle changed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvestigationEventResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {"operationId": "getAdminState", "responses": {"200": {"description": "Administration state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "createUser", "requestBody": {"$ref": "#/components/requestBodies/UserCreate"}, "responses": {"201": {"description": "User created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminUserResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/users/{id}": {
      "patch": {"operationId": "updateUser", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/UserUpdate"}, "responses": {"200": {"description": "User updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminUserResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/teams": {
      "get": {"operationId": "listTeams", "responses": {"200": {"description": "Administration state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "createTeam", "requestBody": {"$ref": "#/components/requestBodies/TeamCreate"}, "responses": {"201": {"description": "Team created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTeamResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/teams/{id}": {
      "patch": {"operationId": "updateTeam", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/TeamUpdate"}, "responses": {"200": {"description": "Team updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTeamResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/team-memberships": {
      "get": {"operationId": "listTeamMemberships", "responses": {"200": {"description": "Administration state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "createTeamMembership", "requestBody": {"$ref": "#/components/requestBodies/TeamMembershipCreate"}, "responses": {"201": {"description": "Membership created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTeamMembershipResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/team-memberships/{id}": {
      "patch": {"operationId": "updateTeamMembership", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/TeamMembershipUpdate"}, "responses": {"200": {"description": "Membership updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTeamMembershipResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/role-bindings": {
      "get": {"operationId": "listRoleBindings", "responses": {"200": {"description": "Administration state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "createRoleBinding", "requestBody": {"$ref": "#/components/requestBodies/RoleBindingCreate"}, "responses": {"201": {"description": "Role binding created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminRoleBindingResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/role-bindings/{id}": {
      "patch": {"operationId": "updateRoleBinding", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/RoleBindingUpdate"}, "responses": {"200": {"description": "Role binding updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminRoleBindingResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/connector-enrollments": {
      "get": {"operationId": "getConnectorAdminState", "responses": {"200": {"description": "Connector Enrollment and registered Cluster state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorAdminStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "createConnectorEnrollment", "requestBody": {"$ref": "#/components/requestBodies/ConnectorEnrollmentCreate"}, "responses": {"201": {"description": "Enrollment created and credential returned once", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorEnrollmentCredentialResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/connector-enrollments/{id}": {
      "patch": {"operationId": "updateConnectorEnrollment", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/ConnectorEnrollmentUpdate"}, "responses": {"200": {"description": "Enrollment rotated or revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorEnrollmentCredentialResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/clusters": {
      "get": {"operationId": "listRegisteredClusters", "responses": {"200": {"description": "Registered Clusters", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorAdminStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/clusters/{id}": {
      "patch": {"operationId": "updateRegisteredCluster", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/ClusterUpdate"}, "responses": {"200": {"description": "Cluster governance fields updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClusterResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/resource-catalog": {
      "get": {"operationId": "getResourceCatalog", "responses": {"200": {"description": "Resource Catalog state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceCatalogStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/services": {
      "get": {"operationId": "listCatalogServices", "responses": {"200": {"description": "Resource Catalog state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceCatalogStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "createCatalogService", "requestBody": {"$ref": "#/components/requestBodies/ServiceCreate"}, "responses": {"201": {"description": "Service created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/resource-bindings": {
      "get": {"operationId": "listResourceBindings", "responses": {"200": {"description": "Resource Catalog state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceCatalogStateResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "confirmResourceBinding", "requestBody": {"$ref": "#/components/requestBodies/ResourceBindingCreate"}, "responses": {"201": {"description": "Resource Binding confirmed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceBindingResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/resource-bindings/{id}": {
      "patch": {"operationId": "correctResourceBinding", "parameters": [{"$ref": "#/components/parameters/Id"}], "requestBody": {"$ref": "#/components/requestBodies/ResourceBindingUpdate"}, "responses": {"200": {"description": "Resource Binding corrected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceBindingResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/connectors/register": {
      "post": {"operationId": "registerConnector", "requestBody": {"$ref": "#/components/requestBodies/ConnectorRegistration"}, "responses": {"200": {"description": "Existing authenticated registration refreshed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorClusterResponse"}}}}, "201": {"description": "First authenticated registration created Cluster presence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorClusterResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/connectors/heartbeat": {
      "post": {"operationId": "recordConnectorHeartbeat", "requestBody": {"$ref": "#/components/requestBodies/ConnectorHeartbeat"}, "responses": {"200": {"description": "Heartbeat recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorClusterResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/connectors/discovery-candidates": {
      "post": {"operationId": "refreshDiscoveryCandidates", "requestBody": {"$ref": "#/components/requestBodies/DiscoveryRefresh"}, "responses": {"200": {"description": "Discovery Candidates refreshed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiscoveryRefreshResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/admin/audit": {
      "get": {"operationId": "listAdminAudit", "responses": {"200": {"description": "Recent administration audit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAuditResponse"}}}}, "403": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "requestBodies": {
      "UserCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserCreateRequest"}}}},
      "UserUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserUpdateRequest"}}}},
      "TeamCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TeamCreateRequest"}}}},
      "TeamUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TeamUpdateRequest"}}}},
      "TeamMembershipCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TeamMembershipCreateRequest"}}}},
      "TeamMembershipUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TeamMembershipUpdateRequest"}}}},
      "RoleBindingCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoleBindingCreateRequest"}}}},
      "RoleBindingUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoleBindingUpdateRequest"}}}},
      "ConnectorEnrollmentCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorEnrollmentCreateRequest"}}}},
      "ConnectorEnrollmentUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorEnrollmentUpdateRequest"}}}},
      "ClusterUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClusterUpdateRequest"}}}},
      "ConnectorRegistration": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorRegistrationRequest"}}}},
      "ConnectorHeartbeat": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConnectorHeartbeatRequest"}}}},
      "DiscoveryRefresh": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiscoveryRefreshRequest"}}}},
      "ServiceCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceCreateRequest"}}}},
      "ResourceBindingCreate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceBindingCreateRequest"}}}},
      "ResourceBindingUpdate": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceBindingUpdateRequest"}}}}
    },
    "responses": {
      "Error": {"description": "Normalized error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password", "session_mode"],
        "properties": {
          "username": {"type": "string", "minLength": 1},
          "password": {"type": "string", "minLength": 1},
          "session_mode": {"const": "cookie"}
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["status", "request_id", "expires_at", "actor"],
        "properties": {
          "service": {"type": "string"},
          "status": {"const": "ok"},
          "request_id": {"type": "string"},
          "expires_at": {"type": "number"},
          "actor": {"$ref": "#/components/schemas/Actor"}
        }
      },
      "LegacyActor": {
        "type": "object",
        "required": ["actor_id", "username", "display_name", "roles", "permissions"],
        "properties": {
          "actor_id": {"type": "string"},
          "username": {"type": "string"},
          "display_name": {"type": "string"},
          "roles": {"type": "array", "items": {"type": "string"}},
          "permissions": {"type": "array", "items": {"type": "string"}}
        }
      },
      "Actor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "username", "display_name", "roles", "capabilities", "is_platform_administrator"],
        "properties": {
          "id": {"type": "string"},
          "username": {"type": "string"},
          "display_name": {"type": "string"},
          "roles": {"type": "array", "items": {"enum": ["platform_administrator", "sre"]}, "uniqueItems": true},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "is_platform_administrator": {"type": "boolean"}
        }
      },
      "Incident": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "status", "lifecycle_state", "binding_status", "cluster_id", "cluster_name", "environment", "namespace", "alertname", "workload_name", "service_name", "team_name", "signal_count", "evidence_revision", "resolved_at", "reopened_at", "created_at", "updated_at"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "status": {"enum": ["active", "resolved"]},
          "lifecycle_state": {"enum": ["firing", "stabilizing", "resolved", "reopened"]},
          "binding_status": {"enum": ["bound", "unbound"]},
          "cluster_id": {"type": "string"},
          "cluster_name": {"type": "string"},
          "environment": {"enum": ["prod", "staging", "dev", "test"]},
          "namespace": {"type": "string"},
          "alertname": {"type": "string"},
          "workload_name": {"type": ["string", "null"]},
          "service_name": {"type": ["string", "null"]},
          "team_name": {"type": ["string", "null"]},
          "signal_count": {"type": "integer", "minimum": 0},
          "evidence_revision": {"type": "integer", "minimum": 0},
          "resolved_at": {"type": ["number", "null"]},
          "reopened_at": {"type": ["number", "null"]},
          "created_at": {"type": "number"},
          "updated_at": {"type": "number"}
        }
      },
      "AlertSignal": {
        "type": "object", "additionalProperties": false,
        "required": ["fingerprint", "alertname", "status", "severity", "summary", "workload_kind", "workload_name", "started_at", "created_at", "updated_at"],
        "properties": {
          "fingerprint": {"type": "string"}, "alertname": {"type": "string"},
          "status": {"enum": ["firing", "recovered"]},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "summary": {"type": "string"},
          "workload_kind": {"type": ["string", "null"]},
          "workload_name": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"]},
          "created_at": {"type": "number"}, "updated_at": {"type": "number"}
        }
      },
      "InvestigationSummary": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sequence", "status", "created_at", "updated_at"],
        "properties": {
          "id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1},
          "status": {"enum": ["queued", "running", "paused", "human_led", "completed", "failed", "terminated"]},
          "created_at": {"type": "number"}, "updated_at": {"type": "number"}
        }
      },
      "IncidentResourceContext": {
        "type": "object", "additionalProperties": false,
        "required": ["cluster_id", "cluster_name", "environment", "runtime_status", "namespace", "workload_kind", "workload_name", "deployment_target_id", "service_id", "service_name", "resource_binding_id", "binding_revision"],
        "properties": {
          "cluster_id": {"type": "string"}, "cluster_name": {"type": "string"},
          "environment": {"enum": ["prod", "staging", "dev", "test"]},
          "runtime_status": {"enum": ["online", "offline", "degraded"]},
          "namespace": {"type": "string"},
          "workload_kind": {"type": ["string", "null"]}, "workload_name": {"type": ["string", "null"]},
          "deployment_target_id": {"type": ["string", "null"]},
          "service_id": {"type": ["string", "null"]}, "service_name": {"type": ["string", "null"]},
          "resource_binding_id": {"type": ["string", "null"]},
          "binding_revision": {"type": ["integer", "null"], "minimum": 1}
        }
      },
      "IncidentResponsibility": {
        "type": "object", "additionalProperties": false,
        "required": ["status", "team_id", "team_name"],
        "properties": {
          "status": {"enum": ["assigned", "unassigned"]},
          "team_id": {"type": ["string", "null"]}, "team_name": {"type": ["string", "null"]}
        }
      },
